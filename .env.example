# Configuration du microservice (a copier en .env, jamais versionne).
# Aucun secret n'est code en dur : tout passe par l'environnement.

# Base de donnees MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskforge_notifications
DB_USER=taskforge
DB_PASSWORD=change-moi

# Cle HMAC partagee avec taskforge-api pour verifier les JWT (HS256).
JWT_SHARED_SECRET=remplacer-par-un-secret-long-et-aleatoire
