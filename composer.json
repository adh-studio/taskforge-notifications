{
    "name": "taskforge/notifications",
    "description": "Microservice de notifications et de rapports pour TaskForge",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "TaskForge\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaskForge\\Notifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
